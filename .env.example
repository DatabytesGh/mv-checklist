# This app's own checklist database (holds all checklist data; NOT user accounts).
# Defaults to ./data/mv-checklist.db
# MV_DB_PATH=C:/path/to/mv-checklist/data/mv-checklist.db

# Shared inventory DB — used ONLY for user accounts (auto-detected if a sibling
# mv-inventory exists). On first run, existing checklist data is copied out of
# this DB into MV_DB_PATH; the inventory DB itself is never modified.
# MV_INVENTORY_DB_PATH=C:/path/to/mv-inventory/data/mv-inventory.db

# WhatsApp Cloud API — this number is SHARED with mv-inventory.
# Shared-number rules (outbound only; no conflict for sending):
#  - Multiple apps can send from the same number simultaneously — the Cloud API
#    send endpoint is stateless, so there is no locking/ownership conflict.
#  - Throughput and the 24h business-initiated messaging tier are PER NUMBER, so
#    they are shared across both apps. Sends auto-retry with backoff on rate limits.
#  - Rotating or revoking META_WA_TOKEN breaks BOTH apps — update both apps'
#    .env.local files together when you generate a new System User token.
#  - Message templates live at the WABA level and are shared. Each app MUST use a
#    unique META_WA_TEMPLATE_PREFIX so template names never collide.
#  - Do NOT point a Meta webhook at this app. Inbound messages / delivery receipts
#    can only be owned by ONE app's webhook, and this app is send-only.
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_WABA_ID=
META_WA_TEMPLATE_LANGS=en_US,en_GB,en
# Per-app template name prefix (must be unique per app sharing the number).
META_WA_TEMPLATE_PREFIX=mmv_

# Session secret for cookie signing
SESSION_SECRET=change-me-in-production

PORT=3004
